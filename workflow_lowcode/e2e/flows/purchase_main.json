{
  "inputVars": [
    { "name": "itemName", "type": "string", "required": true, "desc": "采购品名" },
    { "name": "qty", "type": "number", "required": true, "desc": "数量" },
    { "name": "unitPrice", "type": "number", "required": true, "desc": "单价" },
    { "name": "dept", "type": "string", "required": true, "desc": "申请部门 IT/FIN" },
    { "name": "urgency", "type": "string", "required": false, "desc": "紧急程度" },
    { "name": "reqId", "type": "string", "required": true, "desc": "申请单号" }
  ],
  "nodes": [
    { "id": "start1", "type": "START", "name": "开始", "x": 80, "y": 260 },
    { "id": "t1", "type": "TRANSFORM", "name": "组装载荷", "x": 260, "y": 260,
      "config": { "template": "{\"item\": \"{{itemName}}\", \"dept\": \"{{dept}}\", \"urgency\": \"{{urgency}}\"}" },
      "results": [ { "name": "payload", "mode": "WHOLE" } ] },
    { "id": "h1", "type": "HTTP", "name": "风控评分", "x": 460, "y": 260,
      "config": { "url": "http://127.0.0.1:3000/e2e-mock/risk.json", "method": "GET",
        "headers": {}, "queryParams": [], "bodyParams": [],
        "connTimeoutMs": 3000, "readTimeoutMs": 5000 },
      "retryCount": 2, "backoffMs": 500, "timeoutMs": 15000,
      "results": [ { "name": "riskLevel", "mode": "KEY" }, { "name": "riskScore", "mode": "KEY" } ] },
    { "id": "c1", "type": "CONDITION", "name": "低风险且评分达标", "x": 660, "y": 260,
      "config": { "logic": "ALL", "conditions": [
        { "variable": "riskLevel", "operator": "EQ", "value": "LOW" },
        { "variable": "riskScore", "operator": "LTE", "value": "50" } ] } },
    { "id": "s1", "type": "SCRIPT", "name": "计算含税总额", "x": 880, "y": 140,
      "config": { "language": "groovy",
        "source": "def net = qty * unitPrice\ndef total = net * 1.13\nreturn [total: total, tax: total - net]" },
      "results": [ { "name": "total", "mode": "KEY" }, { "name": "tax", "mode": "KEY" } ] },
    { "id": "sw1", "type": "SWITCH", "name": "按部门路由", "x": 1080, "y": 140,
      "config": { "variable": "dept", "cases": [ { "value": "IT" }, { "value": "FIN" } ] } },
    { "id": "b1", "type": "BEAN", "name": "生成跟踪号", "x": 1300, "y": 60,
      "config": { "beanName": "scriptToolkit", "methodName": "uuid", "params": [] },
      "results": [ { "name": "traceId", "mode": "WHOLE" } ] },
    { "id": "b2", "type": "BEAN", "name": "LLM兜底", "x": 2740, "y": 60,
      "config": { "beanName": "scriptToolkit", "methodName": "uuid", "params": [] },
      "results": [ { "name": "fallbackId", "mode": "WHOLE" } ] },
    { "id": "u1", "type": "BEAN", "name": "生成跟踪号(FIN)", "x": 1300, "y": 220,
      "config": { "beanName": "scriptToolkit", "methodName": "uuid", "params": [] },
      "results": [ { "name": "traceId", "mode": "WHOLE" } ] },
    { "id": "up1", "type": "DATA_UPSERT", "name": "价目落库", "x": 1500, "y": 140,
      "config": { "upserts": [ { "alias": "price", "formKey": "supplier_price",
        "conflictKey": "item_name",
        "values": [
          { "column": "item_name", "value": "{{itemName}}" },
          { "column": "supplier", "value": "平台默认供应商" },
          { "column": "price", "value": "{{unitPrice}}" } ],
        "onUpdate": [] } ] },
      "results": [ { "name": "upsertResult", "mode": "WHOLE" } ] },
    { "id": "bt1", "type": "BATCH", "name": "三家供应商比价", "x": 1700, "y": 140,
      "config": { "collection": "[{\"s\":\"北方钢铁\",\"p\":120},{\"s\":\"南方铝业\",\"p\":95},{\"s\":\"东方电子\",\"p\":210}]",
        "itemVar": "it", "indexVar": "idx", "chunkSize": 1, "intervalMs": 100,
        "stopOnError": true, "maxItems": 100,
        "body": [ { "type": "DATA_INSERT", "name": "写入报价",
          "config": { "formKey": "supplier_quote",
            "data": [
              { "column": "supplier", "value": "{{it.s}}" },
              { "column": "item", "value": "{{itemName}}" },
              { "column": "price", "value": "{{it.p}}" } ] } } ] } },
    { "id": "q1", "type": "DATA_QUERY", "name": "查询报价", "x": 1900, "y": 140,
      "config": { "formKey": "supplier_quote", "filter": [], "size": 50 },
      "results": [ { "name": "rows", "mode": "KEY", "type": "array" } ] },
    { "id": "ag1", "type": "AGGREGATE", "name": "报价汇总", "x": 2100, "y": 140,
      "config": { "collection": "{{rows}}", "field": "price",
        "ops": [ "SUM", "AVG", "COUNT" ], "groupBy": "supplier" },
      "results": [ { "name": "aggrOut", "mode": "WHOLE" } ] },
    { "id": "sql1", "type": "SQL_SCRIPT", "name": "报价行数统计", "x": 2300, "y": 140,
      "config": { "sql": "SELECT COUNT(*) AS cnt FROM wf_biz_supplier_quote", "onError": "abort" },
      "results": [ { "name": "sqlRows", "mode": "KEY" } ] },
    { "id": "d1", "type": "DELAY", "name": "节奏等待", "x": 2420, "y": 140,
      "config": { "durationMs": 500 } },
    { "id": "sf1", "type": "SUBFLOW", "name": "子流程审计", "x": 2520, "y": 140,
      "config": { "flowId": "__SUBFLOW_ID__", "passAllVars": true,
        "varsMapping": [ { "source": "reqId", "target": "reqId" } ] },
      "results": [ { "name": "subOutput", "mode": "WHOLE" } ] },
    { "id": "upd1", "type": "DATA_UPDATE", "name": "审计回写", "x": 2620, "y": 140,
      "config": { "updates": [ { "alias": "log", "table": "wf_biz_audit_log",
        "setOps": [ { "column": "note", "mode": "SET", "value": "主流程已完成" } ],
        "where": [ { "column": "action", "op": "EQ", "value": "SUB_AUDIT" } ] } ] },
      "results": [ { "name": "updated", "mode": "WHOLE" } ] },
    { "id": "del1", "type": "DATA_DELETE", "name": "清理草稿", "x": 2740, "y": 220,
      "config": { "formKey": "supplier_quote",
        "filter": [ { "column": "item", "op": "EQ", "value": "__e2e_cleanup__" } ] } },
    { "id": "llm1", "type": "LLM", "name": "智能摘要", "x": 2840, "y": 140,
      "config": { "prompt": "用一句话总结采购事项：{{itemName}}", "system": "你是采购助手", "temperature": 0.2 } },
    { "id": "ins1", "type": "DATA_INSERT", "name": "高风险落库", "x": 660, "y": 420,
      "config": { "formKey": "audit_log",
        "data": [
          { "column": "req_id", "value": "{{reqId}}" },
          { "column": "action", "value": "REJECT_HIGH_RISK" },
          { "column": "note", "value": "风险等级未通过" } ] } },
    { "id": "n1", "type": "NOTIFY", "name": "通知申请人", "x": 860, "y": 420,
      "config": { "templateCode": "E2E_UNCONFIGURED", "recipientIds": [ "1" ],
        "messageType": "PRIVATE", "channels": [ "IN_APP" ] },
      "errorAction": "IGNORE_CONTINUE" },
    { "id": "end1", "type": "END", "name": "结束", "x": 3040, "y": 160 }
  ],
  "edges": [
    { "id": "e01", "source": "start1", "target": "t1" },
    { "id": "e02", "source": "t1", "target": "h1" },
    { "id": "e03", "source": "h1", "target": "c1" },
    { "id": "e04", "source": "c1", "target": "s1", "branch": "true" },
    { "id": "e05", "source": "c1", "target": "ins1", "branch": "false" },
    { "id": "e06", "source": "s1", "target": "sw1" },
    { "id": "e07", "source": "sw1", "target": "b1", "branch": "case:IT" },
    { "id": "e08", "source": "sw1", "target": "u1", "branch": "case:FIN" },
    { "id": "e09", "source": "sw1", "target": "u1", "branch": "default" },
    { "id": "e10", "source": "b1", "target": "up1" },
    { "id": "e11", "source": "u1", "target": "up1" },
    { "id": "e12", "source": "up1", "target": "bt1" },
    { "id": "e13", "source": "bt1", "target": "q1" },
    { "id": "e14", "source": "q1", "target": "ag1" },
    { "id": "e15", "source": "ag1", "target": "sql1" },
    { "id": "e16", "source": "sql1", "target": "d1" },
    { "id": "e17", "source": "d1", "target": "sf1" },
    { "id": "e18", "source": "sf1", "target": "upd1" },
    { "id": "e19", "source": "upd1", "target": "del1" },
    { "id": "e20", "source": "del1", "target": "llm1" },
    { "id": "e21", "source": "llm1", "target": "end1" },
    { "id": "e22", "source": "llm1", "target": "b2", "branch": "error" },
    { "id": "e23", "source": "b2", "target": "end1" },
    { "id": "e24", "source": "ins1", "target": "n1" },
    { "id": "e25", "source": "n1", "target": "end1" }
  ]
}
